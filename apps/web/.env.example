# ==========================================
# Happy Paws Web (Next.js) - Environment
# ==========================================

# The base URL for the Happy Paws API
# API_URL is for server-side code. NEXT_PUBLIC_API_URL is for client-side components.
API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# The base URL of the Next.js application itself
# Useful for absolute URL generation in metadata or emails (if handled frontend-side).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE
