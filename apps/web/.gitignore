# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# Next.js specific
.next/
out/
build/
.swc/

# testing
coverage/

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (Local secrets)
.env
.env.*
!.env.example
!.env.*.example

# vercel & tooling
.vercel/
.turbo/
*.tsbuildinfo
next-env.d.ts
