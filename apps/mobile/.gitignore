# ==========================================
# Happy Paws Mobile (Flutter) - Git Ignore
# ==========================================

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Environment Files
.env
.env.*
!.env.example
!.env.*.example

# IDEs
*.iml
*.ipr
*.iws
.idea/
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/

# iOS Generated
**/ios/Flutter/.last_build_id
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/ephemeral/

# Android Studio will place build artifacts here
android/app/debug/
android/app/profile/
android/app/release/
android/.gradle/
android/local.properties

# Symbolication related
app.*.symbols
app.*.map.json

# Widget Preview related
.widget_preview/

# Android Signing Keys
*.jks
*.keystore
upload-keystore.jks
