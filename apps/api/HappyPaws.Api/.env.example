# Database
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=happypaws;Username=happypaws_admin;Password=happypaws_dev;
ConnectionStrings__Redis=localhost:6379,password=happypaws_dev,user=happypaws_admin

# Email System
Email__ApiKey=
Email__FromAddress=notifications@happypaws.pet
Email__FromName=Happy Paws

# System Defaults
System__Domain=happypawsnetwork.com
System__CdnBaseUrl=http://localhost:9000/happypaws-public
ENABLE_API_DOCS=true

# CORS Configuration
Cors__AllowedOrigins=http://localhost:3000

# Authentication
Jwt__SecretKey=
Jwt__Issuer=https://api.happypaws.pet
Jwt__Audience=https://happypaws.pet

# Google AI Studio (Gemini)
Gemini__ApiKey=
Gemini__TriageModel=gemini-3.6-flash

# Storage (MinIO for Local Development, Cloudflare R2 for Production)
# Local MinIO configuration:
Storage__ServiceUrl=http://localhost:9000
Storage__AccessKey=happypaws_admin
Storage__SecretKey=happypaws_dev
Storage__PublicBucketName=happypaws-public
Storage__PrivateBucketName=happypaws-private
Storage__PublicCdnUrl=http://localhost:9000/happypaws-public
Storage__ForcePathStyle=true

# Production Cloudflare R2 reference:
# Storage__ServiceUrl=https://<cloudflare_account_id>.r2.cloudflarestorage.com
# Storage__AccessKey=<r2_access_key_id>
# Storage__SecretKey=<r2_secret_access_key>
# Storage__PublicBucketName=happypaws-public
# Storage__PrivateBucketName=happypaws-private
# Storage__PublicCdnUrl=https://cdn.happypawsnetwork.com
# Storage__ForcePathStyle=false
