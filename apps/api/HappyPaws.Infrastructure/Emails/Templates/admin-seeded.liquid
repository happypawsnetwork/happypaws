<!-- Context Badge -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin: 0 auto 16px auto;">
  <tr>
    <td align="center" style="background-color: #E6F7F6; border: 1px solid #B2E5E2; border-radius: 9999px; padding: 5px 14px;">
      <span style="font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #00827F; display: block; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, sans-serif;">
        Initial setup
      </span>
    </td>
  </tr>
</table>

<!-- Main Headline -->
<h1 style="color: #131B26; font-size: 24px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.3; margin: 0 0 10px 0; text-align: center; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif;">
  Administrator account provisioned
</h1>

<!-- Explanatory Copy -->
<p style="color: #475569; font-size: 15px; line-height: 1.6; margin: 0 auto 24px auto; max-width: 440px; text-align: center;">
  An administrator account was automatically provisioned during system startup. Use these initial credentials to access the administrative dashboard.
</p>

<!-- Credentials Card -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin: 0 auto 24px auto; width: 100%; max-width: 420px; background-color: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 14px; padding: 18px 18px;">
  <tr>
    <td align="center">
      <!-- Email Field -->
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 10px;">
        <tr>
          <td align="center" style="background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 8px; padding: 12px 16px; text-align: center;">
            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #5A6878; margin-bottom: 4px;">
              Email address
            </div>
            <div style="font-size: 14px; font-weight: 600; color: #131B26; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, sans-serif; word-break: break-all; user-select: all; -webkit-user-select: all;">
              {{ Email }}
            </div>
          </td>
        </tr>
      </table>

      <!-- Password Field -->
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td align="center" style="background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 8px; padding: 12px 16px; text-align: center;">
            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #5A6878; margin-bottom: 4px;">
              Temporary password
            </div>
            <div style="font-size: 15px; font-weight: 700; color: #00827F; font-family: ui-monospace, 'SF Mono', 'Cascadia Code', 'Segoe UI Mono', Menlo, Monaco, Consolas, monospace; word-break: break-all; user-select: all; -webkit-user-select: all;">
              {{ Password }}
            </div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Call to Action Button -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin: 20px auto 0 auto;">
  <tr>
    <td align="center" style="background-color: #00827F; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 130, 127, 0.25);">
      <a href="{{ WebDashboardUrl }}" target="_blank" style="font-size: 14px; font-weight: 600; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, sans-serif; text-decoration: none; color: #FFFFFF; padding: 12px 28px; display: inline-block; border-radius: 8px; letter-spacing: -0.01em;">
        Sign in to dashboard
      </a>
    </td>
  </tr>
</table>

<!-- Security Notice -->
<p style="color: #64748B; font-size: 13px; line-height: 1.5; margin: 24px auto 0 auto; max-width: 420px; text-align: center;">
  Sign in immediately to update your password and store it safely in your password manager.
</p>
